    "shadcn": "^4.18.0",
    "tailwindcss": "^4.3.3",
    "type-fest": "^5.8.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wxt": "0.21.4"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.7.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
