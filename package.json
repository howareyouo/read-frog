{
  "name": "@read-frog/extension",
  "version": "1.46.7",
  "private": true,
  "description": "Read Frog browser extension for language learning",
  "type": "module",
  "scripts": {
    "build": "wxt build",
    "build:analyze": "wxt build --analyze",
    "build:dev": "WXT_SKIP_ENV_VALIDATION=true wxt build",
    "dev:local": "WXT_USE_LOCAL_PACKAGES=true wxt",
    "dev": "wxt",
    "fmt": "biome format --write .",
    "fmt:check": "biome format .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "postinstall": "WXT_SKIP_ENV_VALIDATION=true wxt prepare",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "zip": "wxt zip"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.31",
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@headless-tree/core": "^1.7.0",
    "@headless-tree/react": "^1.7.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@read-frog/definitions": "0.4.4",
    "@t3-oss/env-core": "^0.13.11",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/hotkeys": "^0.8.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-store": "^0.11.1",
    "@webext-core/match-patterns": "2.0.0",
    "@webext-core/messaging": "^4.0.0",
    "@wxt-dev/i18n": "^0.2.7",
    "@wxt-dev/module-react": "^1.2.2",
    "ai": "^7.0.66",
    "case-anything": "^3.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "css-tree": "^3.2.1",
    "debounce": "^3.0.0",
    "dequal": "^2.0.3",
    "dexie": "^4.4.5",
    "entities": "^8.0.0",
    "jotai": "^2.20.2",
    "jotai-family": "^1.1.0",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.3",
    "react-router": "^8.3.0",
    "react-simple-code-editor": "^0.14.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
